ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG RUST_IMAGE=rust:1.85-bookworm

FROM ${RUST_IMAGE} AS rust-toolchain

FROM ${PYTHON_IMAGE} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

FROM base AS build
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_TARGET_DIR=/tmp/comfyui-rs-target \
    PATH="/usr/local/cargo/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# PyTorch 官方 CUDA 13.2 wheel 自带用户态运行库，GPU 驱动由宿主机提供。
RUN python -m venv .venv \
    && .venv/bin/python -m pip install --index-url https://download.pytorch.org/whl/cu132 \
        "torch==2.15.0+cu132" "torchvision==0.29.2+cu132"

COPY comfyui/requirements.txt comfyui/requirements.txt
RUN .venv/bin/python -m pip install -r comfyui/requirements.txt

# 通过 wheel 的编译元数据核对两类 GPU 的计算架构。
RUN .venv/bin/python -c 'import torch, torchvision; \
    versions = (torch.__version__, torchvision.__version__); \
    assert versions == ("2.15.0+cu132", "0.29.2+cu132"), versions; \
    targets = torch.cuda.get_arch_list(); \
    assert torch.version.cuda == "13.2" and {"sm_90", "sm_120"} <= set(targets), (torch.version.cuda, targets); \
    print("CUDA", torch.version.cuda, "targets:", *targets)'

COPY Cargo.toml Cargo.lock pyproject.toml build.py ./
COPY src/ src/
COPY python/ python/
RUN python build.py --no-deps

COPY . .
RUN cargo test --locked --all-features \
    && .venv/bin/python -m unittest discover -s tests

FROM base AS runtime
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
RUN groupadd --gid 1000 comfyui \
    && useradd --uid 1000 --gid 1000 --create-home comfyui
COPY --from=build --chown=comfyui:comfyui /app/.venv/ /app/.venv/
COPY --chown=comfyui:comfyui . .
RUN install -d -o comfyui -g comfyui \
        /app/models /app/custom_nodes /app/input /app/output /app/user /app/temp /app/previews \
    && install -o comfyui -g comfyui -m 0644 /app/comfyui/input/example.png /app/input/example.png
USER comfyui

# 无 GPU 的构建环境中验证项目入口，实际运行时由 ComfyUI 选择 CUDA 设备。
RUN python main.py --cpu --disable-assets --disable-all-custom-nodes \
    --base-directory /tmp/comfyui-smoke --quick-test-for-ci \
    && rm -rf /tmp/comfyui-smoke

EXPOSE 8188
ENTRYPOINT ["python", "main.py", "--listen", "0.0.0.0"]
